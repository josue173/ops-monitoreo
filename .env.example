# Copiar a .env y cambiar antes de usar en la maqueta
INFLUX_USUARIO=admin
INFLUX_CLAVE=prepago-umg-2026
# Token de administración de InfluxDB: lo usan Grafana, el motor AIOps y Telegraf (también el de pfSense)
INFLUX_TOKEN=token-prepago-cambiar
GRAFANA_USUARIO=admin
GRAFANA_CLAVE=prepago-umg-2026

# URLs que Telegraf comprueba para medir la disponibilidad del portal.
# Laptop con portal-prepago corriendo: los valores por defecto (host.docker.internal:8081/8082).
# Maqueta: http://10.10.30.11:8081/api/salud y http://10.10.30.11:8082/api/salud
# PORTAL_A_URL=
# PORTAL_B_URL=
