{
  "uid": "prepago",
  "title": "Ecosistema prepago: servicios y AIOps",
  "description": "Disponibilidad, latencia, ancho de banda y detección de anomalías del portal cautivo prepago.",
  "tags": [
    "prepago",
    "pfsense",
    "aiops"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumen",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Disponibilidad del portal",
      "description": "Porcentaje de comprobaciones exitosas (HTTP 200 a /api/salud) en el rango de tiempo, por URL comprobada. Fuente: Telegraf http_response cada 10 s.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"http_response\" and r._field == \"result_code\")\n  |> map(fn: (r) => ({r with serie: r.server, _value: if r._value == 0 then 100.0 else 0.0}))\n  |> group(columns: [\"serie\"])\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "displayName": "${__field.labels.serie}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latencia actual a Internet",
      "description": "Tiempo de ida y vuelta promedio de la última medición, por destino.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ping\" and r._field == \"average_response_ms\")\n  |> map(fn: (r) => ({r with serie: r.url}))\n  |> group(columns: [\"serie\"])\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "displayName": "${__field.labels.serie}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Clientes activos",
      "description": "Direcciones IP (IPv4 e IPv6) con tráfico en los últimos 5 minutos, según los logs del firewall.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 13,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"aiops_ventana\" and r._field == \"eventos\")\n  |> group(columns: [\"ip\"])\n  |> last()\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "IPs con tráfico (5 min)",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Anomalías detectadas",
      "description": "Ventanas IP×minuto que el motor AIOps marcó como anómalas en el rango de tiempo.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"aiops_alerta\" and r._field == \"puntaje\")\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "Alertas AIOps en el rango",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Calidad de servicio",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencia a Internet",
      "description": "RTT promedio por destino (IPv4 e IPv6 cuando pfSense mide ambos). Objetivo de QoS: menos de 100 ms.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ping\" and r._field == \"average_response_ms\")\n  |> map(fn: (r) => ({r with serie: r.host + \" → \" + r.url}))\n  |> group(columns: [\"serie\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "displayName": "${__field.labels.serie}",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tiempo de respuesta del portal",
      "description": "Tiempo de respuesta HTTP de /api/salud por réplica y por la VIP de HAProxy. Un hueco indica que la réplica no respondió.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"http_response\" and r._field == \"response_time\")\n  |> map(fn: (r) => ({r with serie: r.server, _value: r._value * 1000.0}))\n  |> group(columns: [\"serie\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "displayName": "${__field.labels.serie}",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Ancho de banda por interfaz",
      "description": "Tráfico en bits por segundo por interfaz y sentido, calculado a partir de los contadores de bytes de Telegraf.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"net\" and (r._field == \"bytes_recv\" or r._field == \"bytes_sent\"))\n  |> derivative(unit: 1s, nonNegative: true)\n  |> map(fn: (r) => ({r with\n      serie: r.host + \" \" + r.interface + (if r._field == \"bytes_recv\" then \" bajada\" else \" subida\"),\n      _value: r._value * 8.0}))\n  |> group(columns: [\"serie\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "displayName": "${__field.labels.serie}",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Seguridad y AIOps",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Eventos del firewall por acción",
      "description": "Paquetes registrados por pfSense por minuto, según la acción de la regla. Un pico de bloqueos suele acompañar a una alerta AIOps.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"firewall\" and r._field == \"eventos\")\n  |> map(fn: (r) => ({r with serie: if r.accion == \"pass\" then \"Permitido\" else \"Bloqueado\"}))\n  |> group(columns: [\"serie\"])\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: 1m, fn: sum, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.serie}",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Permitido"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bloqueado"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D2691E"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Puntaje de anomalía (peor IP por minuto)",
      "description": "Puntaje del modelo Isolation Forest con envolvente de rango. Valores bajo la línea 0 son anomalías; cuanto más negativo, más anómalo.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"aiops_ventana\" and r._field == \"puntaje\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> aggregateWindow(every: 1m, fn: min, createEmpty: false)\n  |> map(fn: (r) => ({r with serie: \"Puntaje mínimo\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "Puntaje mínimo",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "transparent",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Últimas alertas del motor AIOps",
      "description": "Cada fila es una IP cuyo comportamiento en un minuto se apartó de lo normal. El tipo probable lo asignan reglas explícitas sobre las características.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-prepago"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-prepago"
          },
          "query": "from(bucket: \"monitoreo\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"aiops_alerta\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"ip\", \"tipo\", \"puntaje\", \"eventos\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 25)"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Hora"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ip"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "IP de origen"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tipo"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tipo probable"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "puntaje"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Puntaje"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "eventos"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Eventos en el minuto"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    }
  ]
}